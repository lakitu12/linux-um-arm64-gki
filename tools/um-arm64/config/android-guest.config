# Android (redroid-class) guests: the gates config/docker.config does not cover.
#
# The GKI counterpart of the fragments the 7.2 tree carries for the same
# workload (redroid/netfilter in the app repository); every entry below was
# a measured boot gate there.  What is NOT repeated here is already in
# config/docker.config, which the default build merges:
#
#   bpfloader       -> BPF_SYSCALL / CGROUP_BPF
#   lmkd            -> MEMCG (PSI is added below)
#   vold user data  -> EXT4_FS_POSIX_ACL / EXT4_FS_SECURITY
#   netd            -> the full netfilter/nftables/xtables set
#   sdcard daemon   -> FUSE_FS (in ci/snap-flatpak.config)
#   overlayfs, seccomp, keys, POSIX mqueues ... likewise
#
# binder: what Android cannot boot without.  binderfs (Android 12+) gives a
# per-guest /dev/binder, which matters when two VMs share one host kernel.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
#
# ...and binder's own new prerequisite in this tree: ANDROID_BINDER_IPC
# carries "depends on EVENT_TRACING" here (the 7.2 tree does not), so the
# tracing core must exist before the symbol is even visible.  FTRACE opens
# the Tracers menu, and one tracer selects GENERIC_TRACER -> TRACING ->
# EVENT_TRACING; SCHED_TRACER is the lightest of them.  Both lines are
# load-bearing — measured: drop the tracer and binder drops with it; drop
# FTRACE and the tracer has nowhere to live.  Guests get a working tracing
# subsystem out of it as a side effect.
CONFIG_FTRACE=y
CONFIG_SCHED_TRACER=y
#
# lmkd again: boot-critical, exits at startup without a pressure source and
# init's onrestart chain takes zygote down with it.  PSI is the modern source
# (/proc/pressure/memory); the memcg v1 fallback comes from docker.config.
CONFIG_PSI=y
#
# netd's last kernel faces beyond the docker set: the xt owner/socket matches
# its chains use, and socket lookup for both address families.  (The MARK
# target+match rides in docker.config as NETFILTER_XT_MARK — the combined
# module that NETFILTER_XT_TARGET_MARK only selects.)
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
#
# netd: synchronizeKernelRCU() for the network-stats map swap is just
# socket(AF_KEY, SOCK_RAW, PF_KEY_V2) + close(): pfkey_release() calls
# synchronize_rcu() on the way out.  Without NET_KEY the socket call fails
# with EAFNOSUPPORT, netd surfaces that as "synchronizeKernelRCU failed:
# Unknown error -97", and batterystats' WifiPowerStatsCollector turns it into
# a fatal exception in system_server.  Measured on LineageOS 24.0.
CONFIG_NET_KEY=y
#
# Codec2's allocator cannot start without a dma-buf heap, and this port has
# neither /dev/ion nor /dev/dma_heap: C2AllocatorIon::setUsageMapper
# dereferences a null allocator, media.swcodec dies with SIGSEGV, the
# aidl/android.hardware.media.c2.IComponentStore/software instance never
# comes up, MediaProvider follows it down in Codec2Client::createComponent
# and takes system_server with it.  Giving userspace /dev/dma_heap/system is
# enough.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
#
# THP: only the PTE-mapped multi-size half is enabled, PMD-sized THP never is.
# The reason is not memory but host VMAs: a resident guest page costs one host
# mmap, so with vm.max_map_count at 65530 a guest process dies at about 256MB
# when the stub's mmap fails and the stub is declared untrustworthy
# (fatal_sigsegv; system_server was killed every 12-14 minutes).  An order-N
# mTHP folio is contiguous in guest physical memory, so N adjacent guest pages
# land on N adjacent host mappings and map() folds them into one VMA.
#
# PMD-sized THP has to stay out: this port's pmd_t is a software entry holding
# a guest physical address, there is no huge leaf bit and pmd_trans_huge() is
# constant 0, so a PMD mapping written by the generic code is read back as a
# page-table pointer, and the next walk reports a bad pmd and clears the table.
# The defaults are set per CONFIG_UML in hugepage_init_sysfs() (always=order
# 2..PMD_ORDER-1, inherit=0); the global policy is never, so no VMA can reach
# PMD-sized THP through madvise or always either.
#
# The global policy is a Kconfig choice, and merge_config.sh only overwrites
# line by line: it does not clear the ALWAYS=y the defconfig already carries,
# and olddefconfig then sees two members =y and picks the choice default,
# ALWAYS.  Both other members must be explicitly not set, or the kernel ships
# with "always" and everything above is moot.
CONFIG_TRANSPARENT_HUGEPAGE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set
CONFIG_TRANSPARENT_HUGEPAGE_NEVER=y
#
# Input: the app feeds the guest over TCP (port 25999 through passt), and a
# daemon inside turns that into evdev events.  There is no input device to
# write to otherwise -- UML synthesizes none -- so the daemon creates one
# through uinput.  INPUT_MISC is the menu INPUT_UINPUT lives under; without
# it the latter is not even offered, and olddefconfig then drops the request
# silently.
#
# The guest's display is 1024x768 (arch/um/drivers/umfb.h header), which is
# what the daemon declares as its ABS range.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
