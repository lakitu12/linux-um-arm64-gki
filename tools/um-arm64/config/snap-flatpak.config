# Snap and Flatpak: what they need that the docker fragment does not carry.
#
# The default build merges four fragments — the port's config/docker.config,
# its companion ci/docker-completions.config, this file, and
# ci/android-guest.config (see README, "Guest feature set").
# This file deliberately carries ONLY what docker.config does not already
# provide, so the merged .config diffs back to exactly one file per topic.
#
# Snap: the store distributes applications as read-only squashfs images that
# snapd loop-mounts (CONFIG_BLK_DEV_LOOP is already on in the UML defconfig;
# the filesystem is not).  Any of the compressors below can be what a given
# snap was built with, so all of them are on — a missing one fails at mount
# time with "wrong fs type", which names neither the snap nor the compressor.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# Extended attributes ride in squashfs images built on xattr-enabled systems
# (security.selinux labels, file capabilities); cheap, keep on.
CONFIG_SQUASHFS_XATTR=y
#
# Flatpak: every "flatpak run" goes through bubblewrap, and bubblewrap's
# sandbox is user namespaces plus seccomp — both already in docker.config.
# What flatpak adds here is FUSE: the document and revoke portals are FUSE
# filesystems, so /dev/fuse must exist.  (Same driver the Android guests
# need — init's sdcard daemon is one too — so it lives here, one home.)
CONFIG_FUSE_FS=y