# VT — the variant a guest needs to run a real X server, and only that.
#
# Xorg on fbdev binds to a virtual terminal before it touches /dev/fb0:
# parse_vt_settings() issues VT_OPENQRY on /dev/tty0 (or the tty named by
# -keeptty) and gives up with "Cannot find a free VT: Inappropriate ioctl
# for device" when major 4 is not a VT.  Without this fragment /dev/tty0
# is the UML console (major 4, named "UML console" in /proc/tty/drivers)
# and VT_OPENQRY is ENOTTY.
#
# The cost is structural and was measured (run 39141339058): vty_init()
# takes major 4, so the UML stdio console's own tty_register_driver()
# fails with -EBUSY.  Patch 0070 makes the stdio console tolerate that --
# the channels and the printk console keep working (kernel log over
# con0=fd:1, `console=tty0` still resolves) -- but the tty device nodes
# of the UML console are gone, which means:
#   * /dev/console cannot be opened ("Warning: unable to open an initial
#     console"), so init does NOT get its stdio re-pointed at the console;
#   * the app's multi-session `conN=pts` channels have no tty devices.
# This is why VT is NOT in the default display fragment: it is a separate
# variant for "guest runs Xorg", built on top of it.
#
# VT_CONSOLE stays off on purpose: with it on, printk is routed to the
# VT's write path, which in UML has no backend console driver and the
# boot log disappears.  DUMMY_CONSOLE provides the con_driver tty0 needs
# in the absence of fbcon -- Xorg writes fb0 itself through fbdev, it
# never needs a kernel console renderer.
CONFIG_EXPERT=y
CONFIG_VT=y
# CONFIG_VT_CONSOLE is not set
# (VT_CONSOLE_SLEEP is not requested on purpose: with VT_CONSOLE off the
#  symbol is not even visible, and ci/cfg-check.py would report it DROPPED.)
CONFIG_DUMMY_CONSOLE=y
