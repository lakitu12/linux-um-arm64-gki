# virtio-gpu over virtio_uml -- the DRM path that would replace umfb's
# framebuffer mirror with real resources and flips.
#
# UML has no PCI bus of its own, so virtio arrives two ways: virtio_uml talks
# the vhost-user protocol over a unix socket (one device per
# `virtio_uml.device=<socket>:<virtio_id>` on the command line), and
# UML_PCI_OVER_VIRTIO puts a simulated PCI bus on top of that same transport so
# stock virtio-pci drivers enumerate.  UML_PCI selects UML_DMA_EMULATION (which
# is what sets HAS_DMA -- DRM cannot be enabled without it) and
# UML_IOMEM_EMULATION (MMIO accessors).
#
# DRM_FBDEV_EMULATION is deliberate: it gives the guest /dev/fb0 on top of
# virtio-gpu, so the existing viewer/sink chain keeps working while the
# transport underneath is being replaced.
CONFIG_VIRTIO_UML=y
CONFIG_UML_PCI_OVER_VIRTIO=y
# 4160 = 0x1040.  Kconfig int symbols take decimal only: a 0x... value
# is silently dropped and the symbol falls back to its default -1, which
# cfg-check.py then reports as WRONG (run 39205258227).  -1 also makes
# the PCI emulation fail at probe, so a valid id matters.
CONFIG_UML_PCI_OVER_VIRTIO_DEVICE_ID=4160
CONFIG_VIRTIO_PCI=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y
