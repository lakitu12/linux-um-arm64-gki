diff --git a/arch/um/drivers/qcow2.h b/arch/um/drivers/qcow2.h
new file mode 100644
index 0000000..b85853b
--- /dev/null
+++ b/arch/um/drivers/qcow2.h
@@ -0,0 +1,115 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __QCOW2_H__
+#define __QCOW2_H__
+
+/*
+ * qcow2 backend for ubd (read/write subset).
+ *
+ * The engine (qcow2_user.c) is host-side code: it runs in kernel context
+ * at open time (header parsing, L1 load -- the same place cow_user.c runs)
+ * and on the ubd IO helper thread for I/O, where only os_* syscall
+ * wrappers and preallocated memory may be touched.  All runtime buffers
+ * live in one vmalloc'ed arena owned by struct ubd; qcow2_state_size()
+ * computes it and qcow2_init() carves it up.
+ *
+ * Format authority: qemu docs/interop/qcow2.txt, fetched from the v10.0.0
+ * tag (the file became qcow2.rst on master later); see qcow2_user.c for
+ * the exact subset supported and the crash-ordering rules.
+ */
+
+#include <asm/types.h>
+
+#define QCOW2_MAGIC		0x514649fbU	/* "QFI\xfb" */
+
+/* Cache sizes: small on purpose; correctness first, tune with data. */
+#define QCOW2_NL2	4	/* cached L2 tables */
+#define QCOW2_NDC	4	/* cached decompressed clusters */
+#define QCOW2_NRB	2	/* cached refcount blocks */
+
+/* Arena space reserved for the vendored tinfl state (8376 bytes today;
+ * qcow2_user.c has a compile-time check against this constant). */
+#define QCOW2_INFLATE_RESERVE	9216
+
+struct qcow2_geom {
+	__u32 cluster_bits;
+	__u32 l1_size;			/* entries in the active L1 table */
+	__u64 cluster_size;
+	__u64 virt_size;		/* the guest-visible size */
+	__u64 l1_table_offset;
+	__u64 refcount_table_offset;
+	__u32 refcount_table_clusters;
+	__u32 l2_entries;		/* entries per L2 table */
+	__u32 rb_entries;		/* refcount entries per block */
+	__u32 refcount_bits;
+	int read_only;			/* derived: writes must be refused */
+	const char *ro_reason;		/* why, for the open-time printk */
+};
+
+struct qcow2_l2 {
+	__u64 l2_offset;		/* host offset of the table, 0 = free slot */
+	__u32 l1_index;
+	__u8 valid;
+	__u8 dirty;
+	__u8 *buf;
+};
+
+struct qcow2_dc {			/* decompressed-cluster cache */
+	__u64 cluster;			/* cluster index it was made from */
+	__u8 valid;
+	__u8 *buf;
+};
+
+struct qcow2_rb {
+	__u64 table_index;		/* which refcount block this is */
+	__u64 offset;			/* its host offset */
+	__u8 valid;
+	__u8 *buf;
+};
+
+struct qcow2_state {
+	struct qcow2_geom g;
+
+	__u64 *l1;			/* host-order copy of the L1 table */
+	__u8 *rft;			/* refcount table, raw (big-endian) */
+	struct qcow2_l2 l2[QCOW2_NL2];
+	struct qcow2_dc dc[QCOW2_NDC];
+	struct qcow2_rb rb[QCOW2_NRB];
+	__u8 *scratch;			/* one cluster, read-modify-write */
+	__u8 *comp;			/* compressed cluster staging (2*cs) */
+	__u64 comp_max;
+	__u64 alloc_hint;		/* cluster index to start scans at */
+	__u64 max_clusters;		/* refcount coverage limit */
+	__u8 *inflate_state;		/* tinfl_decompressor lives here */
+	__u32 l2_next;			/* round-robin cache cursors */
+	__u32 dc_next;
+	__u32 rb_next;
+};
+
+/* --- kernel context (open time) --------------------------------------- */
+
+/* Is this fd a qcow2 image? (reads the magic; 1 = yes, 0 = no, <0 errno) */
+int qcow2_identify(int fd);
+
+/* Parse + validate the header.  On success fills *g and returns 0; on
+ * failure returns -errno and points *err at a static reason string. */
+int qcow2_read_geom(int fd, struct qcow2_geom *g, const char **err);
+
+/* Size of the arena the engine needs for this geometry (bytes). */
+unsigned long qcow2_state_size(const struct qcow2_geom *g);
+
+/* Carve mem[0..len) into a state; reads the L1 table.  0 or -errno. */
+int qcow2_init(int fd, const struct qcow2_geom *g, void *mem,
+	       unsigned long len, struct qcow2_state **st_out);
+
+/* --- IO helper thread safe -------------------------------------------- */
+
+__u64 qcow2_virtual_size(const struct qcow2_state *st);
+int qcow2_read(struct qcow2_state *st, int fd, __u64 off, unsigned long len,
+	       void *buf);
+int qcow2_write(struct qcow2_state *st, int fd, __u64 off, unsigned long len,
+		const void *buf);
+int qcow2_write_zeroes(struct qcow2_state *st, int fd, __u64 off,
+		       unsigned long len);
+int qcow2_discard(struct qcow2_state *st, int fd, __u64 off, unsigned long len);
+
+#endif /* __QCOW2_H__ */
\ No newline at end of file
diff --git a/arch/um/drivers/qcow2_inflate.h b/arch/um/drivers/qcow2_inflate.h
new file mode 100644
index 0000000..2d275c1
--- /dev/null
+++ b/arch/um/drivers/qcow2_inflate.h
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: MIT */
+/*
+ * tinfl -- the inflate half of miniz, vendored for the UML qcow2 backend.
+ *
+ * Upstream: https://github.com/richgel999/miniz, tag 3.0.2.
+ * Files folded in here: miniz_tinfl.h (flags/status/struct), the type and
+ * macro layers of miniz_common.h.  The code body lives in
+ * qcow2_inflate_user.c (from miniz_tinfl.c), where the full MIT license
+ * text is kept.
+ *
+ * Only the low-level one-shot decompressor is kept: tinfl_decompress()
+ * driven by a caller-provided tinfl_decompressor, with
+ * TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF (the decompressed cluster fits
+ * in the output buffer).  No allocation, no stdio, no global state -- this
+ * is required to run on the ubd IO helper thread, which must not call
+ * kernel functions.
+ *
+ * MZ_ASSERT is deliberately a no-op: aborting the whole UML process on a
+ * corrupt stream is not acceptable; corrupt input surfaces as a non-DONE
+ * status instead.
+ *
+ * One-shot usage (raw deflate stream, no zlib header):
+ *     tinfl_init(&dec);
+ *     in_len = <compressed bytes available>;
+ *     out_len = <output buffer capacity, the cluster size>;
+ *     status = tinfl_decompress(&dec, in, &in_len, out, out, &out_len,
+ *                               TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF);
+ * On success status == TINFL_STATUS_DONE and *out_len has been reduced by
+ * the number of bytes produced (see the mem_to_mem helper upstream); call
+ * it again with the same buffers while status == TINFL_STATUS_HAS_MORE_OUTPUT.
+ */
+#ifndef __QCOW2_INFLATE_H__
+#define __QCOW2_INFLATE_H__
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---- types and macros (miniz_common.h) --------------------------------- */
+
+typedef unsigned char mz_uint8;
+typedef signed short mz_int16;
+typedef unsigned short mz_uint16;
+typedef unsigned int mz_uint32;
+typedef unsigned int mz_uint;
+typedef int64_t mz_int64;
+typedef uint64_t mz_uint64;
+
+#define MZ_MACRO_END while (0)
+#define MZ_ASSERT(x) ((void)0)
+#define MZ_MAX(a, b) (((a) > (b)) ? (a) : (b))
+#define MZ_MIN(a, b) (((a) < (b)) ? (a) : (b))
+#define MZ_CLEAR_ARR(obj) memset((obj), 0, sizeof(obj))
+
+/* Little-endian reads, the portable path of miniz_common.h. */
+#define MZ_READ_LE16(p) ((mz_uint32)(((const mz_uint8 *)(p))[0]) | ((mz_uint32)(((const mz_uint8 *)(p))[1]) << 8U))
+#define MZ_READ_LE32(p) ((mz_uint32)(((const mz_uint8 *)(p))[0]) | ((mz_uint32)(((const mz_uint8 *)(p))[1]) << 8U) | ((mz_uint32)(((const mz_uint8 *)(p))[2]) << 16U) | ((mz_uint32)(((const mz_uint8 *)(p))[3]) << 24U))
+
+/* Both targets of this port (x86_64 and arm64 hosts) have 64-bit
+ * registers; miniz's own probe needs miniz.h, which is not vendored. */
+#define MINIZ_HAS_64BIT_REGISTERS 1
+
+/* ---- decompression flags and status (miniz_tinfl.h) -------------------- */
+
+enum
+{
+    TINFL_FLAG_PARSE_ZLIB_HEADER = 1,
+    TINFL_FLAG_HAS_MORE_INPUT = 2,
+    TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF = 4,
+    TINFL_FLAG_COMPUTE_ADLER32 = 8
+};
+
+typedef enum {
+    TINFL_STATUS_FAILED_CANNOT_MAKE_PROGRESS = -4,
+    TINFL_STATUS_BAD_PARAM = -3,
+    TINFL_STATUS_ADLER32_MISMATCH = -2,
+    TINFL_STATUS_FAILED = -1,
+    TINFL_STATUS_DONE = 0,
+    TINFL_STATUS_NEEDS_MORE_INPUT = 1,
+    TINFL_STATUS_HAS_MORE_OUTPUT = 2
+} tinfl_status;
+
+/* ---- the decompressor state (miniz_tinfl.h) ---------------------------- */
+
+enum
+{
+    TINFL_MAX_HUFF_TABLES = 3,
+    TINFL_MAX_HUFF_SYMBOLS_0 = 288,
+    TINFL_MAX_HUFF_SYMBOLS_1 = 32,
+    TINFL_MAX_HUFF_SYMBOLS_2 = 19,
+    TINFL_FAST_LOOKUP_BITS = 10,
+    TINFL_FAST_LOOKUP_SIZE = 1 << TINFL_FAST_LOOKUP_BITS
+};
+
+#if MINIZ_HAS_64BIT_REGISTERS
+#define TINFL_USE_64BIT_BITBUF 1
+#else
+#define TINFL_USE_64BIT_BITBUF 0
+#endif
+
+#if TINFL_USE_64BIT_BITBUF
+typedef mz_uint64 tinfl_bit_buf_t;
+#define TINFL_BITBUF_SIZE (64)
+#else
+typedef mz_uint32 tinfl_bit_buf_t;
+#define TINFL_BITBUF_SIZE (32)
+#endif
+
+typedef struct tinfl_decompressor_tag tinfl_decompressor;
+
+struct tinfl_decompressor_tag
+{
+    mz_uint32 m_state, m_num_bits, m_zhdr0, m_zhdr1, m_z_adler32, m_final, m_type, m_check_adler32, m_dist, m_counter, m_num_extra, m_table_sizes[TINFL_MAX_HUFF_TABLES];
+    tinfl_bit_buf_t m_bit_buf;
+    size_t m_dist_from_out_buf_start;
+    mz_int16 m_look_up[TINFL_MAX_HUFF_TABLES][TINFL_FAST_LOOKUP_SIZE];
+    mz_int16 m_tree_0[TINFL_MAX_HUFF_SYMBOLS_0 * 2];
+    mz_int16 m_tree_1[TINFL_MAX_HUFF_SYMBOLS_1 * 2];
+    mz_int16 m_tree_2[TINFL_MAX_HUFF_SYMBOLS_2 * 2];
+    mz_uint8 m_code_size_0[TINFL_MAX_HUFF_SYMBOLS_0];
+    mz_uint8 m_code_size_1[TINFL_MAX_HUFF_SYMBOLS_1];
+    mz_uint8 m_code_size_2[TINFL_MAX_HUFF_SYMBOLS_2];
+    mz_uint8 m_raw_header[4], m_len_codes[TINFL_MAX_HUFF_SYMBOLS_0 + TINFL_MAX_HUFF_SYMBOLS_1 + 137];
+};
+
+/* Initializes the decompressor to its initial state. */
+#define tinfl_init(r)     \
+    do                    \
+    {                     \
+        (r)->m_state = 0; \
+    }                     \
+    MZ_MACRO_END
+#define tinfl_get_adler32(r) (r)->m_check_adler32
+
+tinfl_status tinfl_decompress(tinfl_decompressor *r, const mz_uint8 *pIn_buf_next, size_t *pIn_buf_size, mz_uint8 *pOut_buf_start, mz_uint8 *pOut_buf_next, size_t *pOut_buf_size, const mz_uint32 decomp_flags);
+
+#endif /* __QCOW2_INFLATE_H__ */
\ No newline at end of file
diff --git a/arch/um/drivers/qcow2_inflate_user.c b/arch/um/drivers/qcow2_inflate_user.c
new file mode 100644
index 0000000..503a1ee
--- /dev/null
+++ b/arch/um/drivers/qcow2_inflate_user.c
@@ -0,0 +1,678 @@
+/*
+ * tinfl -- the inflate half of miniz, vendored for the UML qcow2 backend.
+ *
+ * Upstream: https://github.com/richgel999/miniz, tag 3.0.2.
+ * This file is miniz_tinfl.c, with three changes: the provenance block
+ * above the original license, the include redirected to qcow2_inflate.h
+ * (which carries the type/macro layer of miniz_common.h and the public
+ * declarations of miniz_tinfl.h), and everything from
+ * tinfl_decompress_mem_to_heap() downwards dropped -- the high-level
+ * helpers allocate and are not needed; only tinfl_clear_tree() and
+ * tinfl_decompress() are kept, both allocation-free.
+ *
+ *
+ * Copyright 2013-2014 RAD Game Tools and Valve Software
+ * Copyright 2010-2014 Rich Geldreich and Tenacious Software LLC
+ * All Rights Reserved.
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy
+ * of this software and associated documentation files (the "Software"), to deal
+ * in the Software without restriction, including without limitation the rights
+ * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+ * copies of the Software, and to permit persons to whom the Software is
+ * furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+ * THE SOFTWARE.
+ *
+ **************************************************************************/
+
+
+#include "qcow2_inflate.h"
+
+/* ------------------- Low-level Decompression (completely independent from all compression API's) */
+
+#define TINFL_MEMCPY(d, s, l) memcpy(d, s, l)
+#define TINFL_MEMSET(p, c, l) memset(p, c, l)
+
+#define TINFL_CR_BEGIN  \
+    switch (r->m_state) \
+    {                   \
+        case 0:
+#define TINFL_CR_RETURN(state_index, result) \
+    do                                       \
+    {                                        \
+        status = result;                     \
+        r->m_state = state_index;            \
+        goto common_exit;                    \
+        case state_index:;                   \
+    }                                        \
+    MZ_MACRO_END
+#define TINFL_CR_RETURN_FOREVER(state_index, result) \
+    do                                               \
+    {                                                \
+        for (;;)                                     \
+        {                                            \
+            TINFL_CR_RETURN(state_index, result);    \
+        }                                            \
+    }                                                \
+    MZ_MACRO_END
+#define TINFL_CR_FINISH }
+
+#define TINFL_GET_BYTE(state_index, c)                                                                                                                           \
+    do                                                                                                                                                           \
+    {                                                                                                                                                            \
+        while (pIn_buf_cur >= pIn_buf_end)                                                                                                                       \
+        {                                                                                                                                                        \
+            TINFL_CR_RETURN(state_index, (decomp_flags & TINFL_FLAG_HAS_MORE_INPUT) ? TINFL_STATUS_NEEDS_MORE_INPUT : TINFL_STATUS_FAILED_CANNOT_MAKE_PROGRESS); \
+        }                                                                                                                                                        \
+        c = *pIn_buf_cur++;                                                                                                                                      \
+    }                                                                                                                                                            \
+    MZ_MACRO_END
+
+#define TINFL_NEED_BITS(state_index, n)                \
+    do                                                 \
+    {                                                  \
+        mz_uint c;                                     \
+        TINFL_GET_BYTE(state_index, c);                \
+        bit_buf |= (((tinfl_bit_buf_t)c) << num_bits); \
+        num_bits += 8;                                 \
+    } while (num_bits < (mz_uint)(n))
+#define TINFL_SKIP_BITS(state_index, n)      \
+    do                                       \
+    {                                        \
+        if (num_bits < (mz_uint)(n))         \
+        {                                    \
+            TINFL_NEED_BITS(state_index, n); \
+        }                                    \
+        bit_buf >>= (n);                     \
+        num_bits -= (n);                     \
+    }                                        \
+    MZ_MACRO_END
+#define TINFL_GET_BITS(state_index, b, n)    \
+    do                                       \
+    {                                        \
+        if (num_bits < (mz_uint)(n))         \
+        {                                    \
+            TINFL_NEED_BITS(state_index, n); \
+        }                                    \
+        b = bit_buf & ((1 << (n)) - 1);      \
+        bit_buf >>= (n);                     \
+        num_bits -= (n);                     \
+    }                                        \
+    MZ_MACRO_END
+
+/* TINFL_HUFF_BITBUF_FILL() is only used rarely, when the number of bytes remaining in the input buffer falls below 2. */
+/* It reads just enough bytes from the input stream that are needed to decode the next Huffman code (and absolutely no more). It works by trying to fully decode a */
+/* Huffman code by using whatever bits are currently present in the bit buffer. If this fails, it reads another byte, and tries again until it succeeds or until the */
+/* bit buffer contains >=15 bits (deflate's max. Huffman code size). */
+#define TINFL_HUFF_BITBUF_FILL(state_index, pLookUp, pTree)                    \
+    do                                                                         \
+    {                                                                          \
+        temp = pLookUp[bit_buf & (TINFL_FAST_LOOKUP_SIZE - 1)];                \
+        if (temp >= 0)                                                         \
+        {                                                                      \
+            code_len = temp >> 9;                                              \
+            if ((code_len) && (num_bits >= code_len))                          \
+                break;                                                         \
+        }                                                                      \
+        else if (num_bits > TINFL_FAST_LOOKUP_BITS)                            \
+        {                                                                      \
+            code_len = TINFL_FAST_LOOKUP_BITS;                                 \
+            do                                                                 \
+            {                                                                  \
+                temp = pTree[~temp + ((bit_buf >> code_len++) & 1)];           \
+            } while ((temp < 0) && (num_bits >= (code_len + 1)));              \
+            if (temp >= 0)                                                     \
+                break;                                                         \
+        }                                                                      \
+        TINFL_GET_BYTE(state_index, c);                                        \
+        bit_buf |= (((tinfl_bit_buf_t)c) << num_bits);                         \
+        num_bits += 8;                                                         \
+    } while (num_bits < 15);
+
+/* TINFL_HUFF_DECODE() decodes the next Huffman coded symbol. It's more complex than you would initially expect because the zlib API expects the decompressor to never read */
+/* beyond the final byte of the deflate stream. (In other words, when this macro wants to read another byte from the input, it REALLY needs another byte in order to fully */
+/* decode the next Huffman code.) Handling this properly is particularly important on raw deflate (non-zlib) streams, which aren't followed by a byte aligned adler-32. */
+/* The slow path is only executed at the very end of the input buffer. */
+/* v1.16: The original macro handled the case at the very end of the passed-in input buffer, but we also need to handle the case where the user passes in 1+zillion bytes */
+/* following the deflate data and our non-conservative read-ahead path won't kick in here on this code. This is much trickier. */
+#define TINFL_HUFF_DECODE(state_index, sym, pLookUp, pTree)                                                                         \
+    do                                                                                                                              \
+    {                                                                                                                               \
+        int temp;                                                                                                                   \
+        mz_uint code_len, c;                                                                                                        \
+        if (num_bits < 15)                                                                                                          \
+        {                                                                                                                           \
+            if ((pIn_buf_end - pIn_buf_cur) < 2)                                                                                    \
+            {                                                                                                                       \
+                TINFL_HUFF_BITBUF_FILL(state_index, pLookUp, pTree);                                                                \
+            }                                                                                                                       \
+            else                                                                                                                    \
+            {                                                                                                                       \
+                bit_buf |= (((tinfl_bit_buf_t)pIn_buf_cur[0]) << num_bits) | (((tinfl_bit_buf_t)pIn_buf_cur[1]) << (num_bits + 8)); \
+                pIn_buf_cur += 2;                                                                                                   \
+                num_bits += 16;                                                                                                     \
+            }                                                                                                                       \
+        }                                                                                                                           \
+        if ((temp = pLookUp[bit_buf & (TINFL_FAST_LOOKUP_SIZE - 1)]) >= 0)                                                          \
+            code_len = temp >> 9, temp &= 511;                                                                                      \
+        else                                                                                                                        \
+        {                                                                                                                           \
+            code_len = TINFL_FAST_LOOKUP_BITS;                                                                                      \
+            do                                                                                                                      \
+            {                                                                                                                       \
+                temp = pTree[~temp + ((bit_buf >> code_len++) & 1)];                                                                \
+            } while (temp < 0);                                                                                                     \
+        }                                                                                                                           \
+        sym = temp;                                                                                                                 \
+        bit_buf >>= code_len;                                                                                                       \
+        num_bits -= code_len;                                                                                                       \
+    }                                                                                                                               \
+    MZ_MACRO_END
+
+static void tinfl_clear_tree(tinfl_decompressor *r)
+{
+    if (r->m_type == 0)
+        MZ_CLEAR_ARR(r->m_tree_0);
+    else if (r->m_type == 1)
+        MZ_CLEAR_ARR(r->m_tree_1);
+    else
+        MZ_CLEAR_ARR(r->m_tree_2);
+}
+
