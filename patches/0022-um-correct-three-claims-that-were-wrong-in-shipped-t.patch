index 4cfd2b6..0641f18 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -6,7 +6,13 @@ config UML_ARM64
 	select ARCH_USE_QUEUED_RWLOCKS
 	select ARCH_USE_QUEUED_SPINLOCKS
 	select HAVE_EFFICIENT_UNALIGNED_ACCESS
-	select MODULES_USE_ELF_RELA
+	#
+	# MODULES_USE_ELF_RELA is deliberately NOT selected yet. aarch64 modules
+	# are indeed RELA, but nothing here implements apply_relocate_add(), so
+	# selecting it would assert a capability that does not exist. CONFIG_MODULES
+	# is off in the defconfig; allmodconfig and randconfig will not link until
+	# module support lands, and that is honest rather than hidden.
+	#
 	#
 	# The guest's syscall ABI must match what aarch64 userspace was built
 	# against, and that is decided here rather than by arch/arm64/Kconfig,
diff --git a/arch/arm64/um/shared/sysdep/ptrace_user.h b/arch/arm64/um/shared/sysdep/ptrace_user.h
index f3a0bd8..d709128 100644
--- a/arch/arm64/um/shared/sysdep/ptrace_user.h
+++ b/arch/arm64/um/shared/sysdep/ptrace_user.h
@@ -30,9 +30,9 @@
  * ends. ptrace_save_reg() in arch/arm64/kernel/ptrace.c spells out the
