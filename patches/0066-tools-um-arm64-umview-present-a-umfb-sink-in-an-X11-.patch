From b4973395be8ca73befa3e4ad0323f720587b14ea Mon Sep 17 00:00:00 2001
From: lakitu12 <1219387824@qq.com>
Date: Sun, 18 Oct 2026 18:38:20 +0800
Subject: [PATCH] tools/um-arm64: umview -- present a umfb sink in an
 X11/Wayland window

The Linux-side reader for the umfb wire format: maps the sink (a path
or fd:N), waits for the kernel's header, and presents the changed
tiles through SDL2 -- which selects X11 or Wayland for the session at
hand -- letterbox-scaling on resize.  --probe checks a sink without a
window (the exit code is the verdict, for scripts); --shot saves a BMP
of the first frame so screen-level verification does not need a
screenshot tool; --frames bounds a run for tests.

umfb.h next to it is a verbatim copy of arch/um/drivers/umfb.h; the
viewer checks magic and version at runtime, so a stale copy fails
loudly instead of presenting garbage.
---
 tools/um-arm64/umview/Makefile |  23 ++
 tools/um-arm64/umview/umfb.h   | 102 ++++++++
 tools/um-arm64/umview/umview.c | 443 +++++++++++++++++++++++++++++++++
 3 files changed, 568 insertions(+)
 create mode 100644 tools/um-arm64/umview/Makefile
 create mode 100644 tools/um-arm64/umview/umfb.h
 create mode 100644 tools/um-arm64/umview/umview.c

diff --git a/tools/um-arm64/umview/Makefile b/tools/um-arm64/umview/Makefile
new file mode 100644
index 0000000..48b7560
--- /dev/null
+++ b/tools/um-arm64/umview/Makefile
@@ -0,0 +1,23 @@
+# umview -- SDL2 viewer for a umfb sink (UML on-screen framebuffer).
+#
+# The wire format header (umfb.h) is a verbatim copy of
+# arch/um/drivers/umfb.h; keep them in sync (the viewer checks magic +
+# version at runtime, so a stale copy fails loudly, not silently).
+#
+#   make            build ./umview
+#   make clean
+#
+# Needs libsdl2-dev (Debian/Ubuntu: apt install libsdl2-dev).
+
+CC      ?= gcc
+CFLAGS  ?= -O2 -Wall -Wextra
+CFLAGS  += $(shell sdl2-config --cflags)
+LDLIBS  += $(shell sdl2-config --libs)
+
+umview: umview.c umfb.h
+	$(CC) $(CFLAGS) -o $@ umview.c $(LDLIBS)
+
+clean:
+	rm -f umview
+
+.PHONY: clean
\ No newline at end of file
diff --git a/tools/um-arm64/umview/umfb.h b/tools/um-arm64/umview/umfb.h
new file mode 100644
index 0000000..1bce4f8
--- /dev/null
+++ b/tools/um-arm64/umview/umfb.h
@@ -0,0 +1,102 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * umfb -- shared-memory display for UML guests: the wire format.
+ *
+ * The kernel-side driver (umfb_kern.c) registers a framebuffer whose
+ * pixels are mirrored, tile by tile, into a host file or descriptor
+ * ("the sink").  Host-side viewers -- tools/um-arm64/umview on Linux,
+ * the console app on Android -- map the same sink and present the
+ * tiles.  Guests see an ordinary /dev/fb0 (redroid's SurfaceFlinger,
+ * Xorg's fbdev driver, weston's fbdev backend all land there).
+ *
+ * File layout:
+ *   [0, 1024)		struct umfb_hdr
+ *   [1024, ...)	pixels, stride * height bytes, top-down,
+ *			format UMFB_FMT_RGBA8888 (bytes R,G,B,A)
+ *
+ * Update protocol (one producer: the pump thread; any number of
+ * readers: the host-side viewers):
+ *
+ *   1. the producer writes the changed pixel data for this round;
+ *   2. the producer stores dirty_words[] and full for this round;
+ *   3. the producer bumps seq with release semantics.
+ *
+ *   A reader: loads seq with acquire semantics; if it moved since the
+ *   reader's last look, snapshots full/dirty_words, copies the dirty
+ *   tiles out of the pixel area, then re-checks seq and repeats if it
+ *   moved again.  A reader can therefore only ever see a torn tile
+ *   belonging to a frame that is already being replaced by the next
+ *   one -- this is a live display stream, not a database, and the
+ *   following frame repairs it.
+ *
+ * This header is deliberately plain C (no includes at all): a verbatim
+ * copy lives in the viewers (tools/um-arm64/umview/umview.c and the
+ * app's app/display/umldisp.c).  Bump UMFB_VERSION for any layout
+ * change and update the copies; the readers check magic+version.
+ */
+#ifndef _UMFB_H_
+#define _UMFB_H_
+
+#define UMFB_MAGIC		0x4D424655u	/* "UFBM", little-endian */
+#define UMFB_VERSION		1
+
+#define UMFB_FMT_RGBA8888	1	/* bytes R,G,B,A (alpha ignored) */
+
+#define UMFB_HDR_SIZE		1024	/* header bytes, pixels follow */
+#define UMFB_MAX_TILES		4096	/* covers up to 5120x4096 of 64px tiles */
+#define UMFB_MAX_WORDS		(UMFB_MAX_TILES / 32)
+
+#define UMFB_TILE_SHIFT_DEFAULT	6	/* 64x64 pixels */
+#define UMFB_HZ_DEFAULT		30
+
+/* state */
+#define UMFB_STATE_INIT		0
+#define UMFB_STATE_LIVE		1
+
+struct umfb_hdr {
+	unsigned int magic;		/* UMFB_MAGIC */
+	unsigned int version;		/* UMFB_VERSION */
+	unsigned int width;		/* visible pixels */
+	unsigned int height;
+	unsigned int stride;		/* bytes per row */
+	unsigned int bpp;		/* always 32 for now */
+	unsigned int format;		/* UMFB_FMT_* */
+	unsigned int tile_shift;	/* tile edge = 1 << tile_shift pixels */
+	unsigned int tiles_x;
+	unsigned int tiles_y;
+	unsigned int tiles_total;	/* tiles_x * tiles_y */
+	unsigned int hz;		/* pump rate, informational */
+	unsigned int state;		/* UMFB_STATE_* */
+	volatile unsigned int seq;	/* frames published */
+	volatile unsigned int full;	/* this round: whole frame dirty */
+	unsigned int reserved0;
+	volatile unsigned int dirty_words[UMFB_MAX_WORDS];	/* 4096 tiles */
+	unsigned int reserved[112];	/* pad to UMFB_HDR_SIZE; input soon */
+};
+
+#ifdef __KERNEL__
+/*
+ * Kernel-internal plumbing -- NOT part of the wire format.  The readers
+ * must not see any of this; it is why the block is fenced off.
+ *
+ * The pump runs on a UML helper thread (os_run_helper_thread), the same
+ * shape ubd's io thread has, because that thread "is not part of the
+ * kernel": it may only touch plain memory and host calls, which is all
+ * the pump needs (umfb_user.c carries the full explanation).
+ */
+struct umfb_pump {
+	unsigned char *fb;		/* the guest-visible pixels */
+	unsigned char *pix;		/* pixels[] in the sink */
+	struct umfb_hdr *hdr;
+	unsigned int width, height, stride;
+	unsigned int tile_shift, tiles_x, tiles_y, tiles_total, words;
+	unsigned int pump_ms;
+	unsigned int bitmap[UMFB_MAX_WORDS];
+};
+
+int umfb_sink_open(const char *src, unsigned long long need, int *fd_out);
+void *umfb_sink_map(int fd, unsigned long long size);
+int umfb_pump_start(struct os_helper_thread **td, struct umfb_pump *p);
+#endif	/* __KERNEL__ */
+
+#endif	/* _UMFB_H_ */
\ No newline at end of file
diff --git a/tools/um-arm64/umview/umview.c b/tools/um-arm64/umview/umview.c
new file mode 100644
index 0000000..81f58f6
--- /dev/null
+++ b/tools/um-arm64/umview/umview.c
@@ -0,0 +1,443 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * umview -- a host window for a UML on-screen framebuffer (umfb).
+ *
+ * The guest draws into /dev/fb0; the UML kernel's umfb driver mirrors
+ * the changed 64x64 tiles into a shared sink file (arch/um/drivers/
+ * umfb.h is the wire format; a verbatim copy of the header sits next
+ * to this file).  This program maps the sink and presents it -- under
+ * X11, under Wayland, or wherever else SDL2 finds a video driver.  The
+ * Android console app's display screen speaks the same protocol, so
+ * the file is the interface; this viewer is one client of it.
+ *
+ * Usage:
+ *   umview [options] <sink>          sink: a path, or fd:N
+ *
+ *   --title S       window title (default "umfb <W>x<H>")
+ *   --scale F       initial window scale (default 1)
+ *   --fullscreen    start fullscreen (F11 toggles, Esc quits)
+ *   --probe         no window: wait for the sink, print its state, exit
+ *   --wait SEC      wait up to SEC for a valid sink (default 30; probe
+ *                   waits for the first published frame instead)
+ *   --shot FILE     save a BMP of the first presented frame
+ *   --frames N      exit after presenting N frames (tests)
+ *   --px X,Y        print the sink pixel at X,Y as hex (diagnostics)
+ *
+ * Build: make   (needs libsdl2-dev)
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdarg.h>
+#include <signal.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+#include <time.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+
+#include <SDL.h>
+
+#include "umfb.h"
+
+struct uv {
+	const char *src;
+	int fd;
+	unsigned char *map;
+	size_t maplen;
+	struct umfb_hdr *hdr;
+	unsigned char *pix;
+
+	unsigned int w, h, stride, ts, tx, ty, total, words;
+
+	SDL_Window *win;
+	SDL_Renderer *ren;
+	SDL_Texture *tex;
+
+	uint32_t last_seq;
+	int have_last;
+	unsigned int shown;
+
+	const char *shot;	/* save one BMP once the first frame is up */
+	unsigned int frame_limit;	/* exit after N presented frames */
+};
+
+static volatile sig_atomic_t interrupted;
+
+static void on_sigint(int sig)
+{
+	(void) sig;
+	interrupted = 1;
+}
+
+static void die(const char *fmt, ...)
+{
+	va_list ap;
+
+	va_start(ap, fmt);
+	fprintf(stderr, "umview: ");
+	vfprintf(stderr, fmt, ap);
+	fprintf(stderr, "\n");
+	va_end(ap);
+	exit(1);
+}
+
+static long now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long) ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+/*
+ * Open the sink and wait for the kernel to have published a header.
+ * The file may exist empty (created by a launcher) or not exist yet
+ * when the viewer races the guest; wait_ms bounds the wait.
+ */
+static void uv_open(struct uv *u, long wait_ms)
+{
+	struct stat st;
+	long t0;
+	int waited = 0;
+
+	if (!strncmp(u->src, "fd:", 3)) {
+		char *end;
+		long n = strtol(u->src + 3, &end, 10);
+
+		if (end == u->src + 3 || *end || n < 0 || n > 1 << 20)
+			die("bad sink '%s'", u->src);
+		u->fd = dup((int) n);
+	} else {
+		u->fd = open(u->src, O_RDONLY);
+	}
+	if (u->fd < 0)
+		die("open %s: %s", u->src, strerror(errno));
+
+	if (fstat(u->fd, &st) || st.st_size < UMFB_HDR_SIZE) {
+		if (wait_ms <= 0)
+			die("%s: too small for a umfb header (%lld bytes)",
+			    u->src, (long long) st.st_size);
+		waited = 1;	/* size grows when the kernel sizes it */
+	}
+
+	u->maplen = st.st_size > 0 ? (size_t) st.st_size : 0;
+	if (waited || !u->maplen) {
+		/* wait for a first plausible size before mapping */
+		t0 = now_ms();
+		while (now_ms() - t0 < wait_ms) {
+			usleep(20000);
+			if (!fstat(u->fd, &st) && st.st_size >= UMFB_HDR_SIZE) {
+				u->maplen = (size_t) st.st_size;
+				break;
+			}
+		}
+		if (u->maplen < UMFB_HDR_SIZE)
+			die("%s: no umfb header appeared (guest up with umlfb=?)",
+			    u->src);
+	}
+
+	u->map = mmap(NULL, u->maplen, PROT_READ, MAP_SHARED, u->fd, 0);
+	if (u->map == MAP_FAILED)
+		die("mmap %s: %s", u->src, strerror(errno));
+	u->hdr = (struct umfb_hdr *) u->map;
+
+	/* wait for the magic (the kernel fills the header at driver init) */
+	t0 = now_ms();
+	while (__atomic_load_n(&u->hdr->magic, __ATOMIC_ACQUIRE) != UMFB_MAGIC ||
+	       __atomic_load_n(&u->hdr->version, __ATOMIC_ACQUIRE) != UMFB_VERSION) {
+		if (now_ms() - t0 >= wait_ms)
+			die("%s: no valid umfb header (magic=%08x version=%u) "
+			    "-- is the guest running with umlfb=?",
+			    u->src, u->hdr->magic, u->hdr->version);
+		usleep(20000);
+	}
+
+	u->w = u->hdr->width;
+	u->h = u->hdr->height;
+	u->stride = u->hdr->stride;
+	u->ts = u->hdr->tile_shift;
+	u->tx = u->hdr->tiles_x;
+	u->ty = u->hdr->tiles_y;
+	u->total = u->hdr->tiles_total;
+
+	if (!u->w || !u->h || u->hdr->format != UMFB_FMT_RGBA8888 ||
+	    u->hdr->bpp != 32 || u->stride < u->w * 4 ||
+	    u->total != u->tx * u->ty || u->total > UMFB_MAX_TILES ||
+	    u->ts < 4 || u->ts > 8)
+		die("%s: implausible header (%ux%u stride %u fmt %u)",
+		    u->src, u->w, u->h, u->stride, u->hdr->format);
+
+	u->words = (u->total + 31) / 32;
+	if (u->maplen < UMFB_HDR_SIZE + (size_t) u->stride * u->h)
+		die("%s: file holds %zu bytes, the mode needs %zu", u->src,
+		    u->maplen, UMFB_HDR_SIZE + (size_t) u->stride * u->h);
+
+	u->pix = u->map + UMFB_HDR_SIZE;
+}
+
+static void uv_paint_full(struct uv *u)
+{
+	SDL_UpdateTexture(u->tex, NULL, u->pix, (int) u->stride);
+}
+
+static void uv_paint_tiles(struct uv *u, const uint32_t *words)
+{
+	unsigned int wi;
+
+	for (wi = 0; wi < u->words; wi++) {
+		uint32_t bits = words[wi];
+
+		while (bits) {
+			int b = __builtin_ctz(bits);
+			unsigned int idx = wi * 32 + (unsigned int) b;
+			unsigned int x0, y0, tw, th;
+			SDL_Rect r;
+
+			bits &= bits - 1;
+			if (idx >= u->total)
+				continue;
+			x0 = (idx % u->tx) << u->ts;
+			y0 = (idx / u->tx) << u->ts;
+			tw = (1u << u->ts) < u->w - x0 ? (1u << u->ts) : u->w - x0;
+			th = (1u << u->ts) < u->h - y0 ? (1u << u->ts) : u->h - y0;
+			r.x = (int) x0;
+			r.y = (int) y0;
+			r.w = (int) tw;
+			r.h = (int) th;
+			/* le32 0xAABBGGRR == bytes R,G,B,A == ABGR8888 */
+			SDL_UpdateTexture(u->tex, &r,
+					  u->pix + (size_t) y0 * u->stride +
+					  (size_t) x0 * 4, (int) u->stride);
+		}
+	}
+}
+
+static void uv_present(struct uv *u)
+{
+	SDL_RenderClear(u->ren);
+	SDL_RenderCopy(u->ren, u->tex, NULL, NULL);
+	SDL_RenderPresent(u->ren);
+}
+
+static void uv_shot(struct uv *u, const char *file)
+{
+	SDL_Surface *s;
+	int ww, wh;
+	void *pix;
+	int pitch;
+
+	SDL_GetWindowSize(u->win, &ww, &wh);
+	pitch = ww * 4;
+	pix = malloc((size_t) pitch * wh);
+	if (!pix) {
+		fprintf(stderr, "umview: shot: out of memory\n");
+		return;
+	}
+	if (SDL_RenderReadPixels(u->ren, NULL, SDL_PIXELFORMAT_ARGB8888,
+				 pix, pitch) != 0) {
+		fprintf(stderr, "umview: shot: %s\n", SDL_GetError());
+		free(pix);
+		return;
+	}
+	s = SDL_CreateRGBSurfaceWithFormatFrom(pix, ww, wh, 32, pitch,
+					       SDL_PIXELFORMAT_ARGB8888);
+	if (s && SDL_SaveBMP(s, file) == 0)
+		fprintf(stderr, "umview: shot saved: %s (%dx%d)\n", file, ww, wh);
+	else
+		fprintf(stderr, "umview: shot save failed: %s\n", SDL_GetError());
+	if (s)
+		SDL_FreeSurface(s);
+	free(pix);
+}
+
+static void uv_probe_px(struct uv *u, const char *spec)
+{
+	unsigned int x, y;
+
+	if (sscanf(spec, "%u,%u", &x, &y) != 2 || x >= u->w || y >= u->h)
+		die("--px wants X,Y within the mode");
+	printf("UMVIEW-PX %u,%u=%08x\n", x, y,
+	       *(uint32_t *) (u->pix + (size_t) y * u->stride + x * 4));
+}
+
+int main(int argc, char **argv)
+{
+	struct uv u;
+	const char *sink = NULL, *title = NULL, *pxspec = NULL, *shot = NULL;
+	const char *scale = "1";
+	long wait_ms = 30000;
+	int probe = 0, fullscreen = 0, i, rc = 0;
+
+	memset(&u, 0, sizeof(u));
+
+	for (i = 1; i < argc; i++) {
+		const char *a = argv[i];
+
+		if (!strcmp(a, "--title") && i + 1 < argc)
+			title = argv[++i];
+		else if (!strcmp(a, "--scale") && i + 1 < argc)
+			scale = argv[++i];
+		else if (!strcmp(a, "--wait") && i + 1 < argc)
+			wait_ms = atol(argv[++i]) * 1000;
+		else if (!strcmp(a, "--shot") && i + 1 < argc)
+			shot = argv[++i];
+		else if (!strcmp(a, "--frames") && i + 1 < argc)
+			u.frame_limit = (unsigned int) atol(argv[++i]);
+		else if (!strcmp(a, "--px") && i + 1 < argc)
+			pxspec = argv[++i];
+		else if (!strcmp(a, "--probe"))
+			probe = 1;
+		else if (!strcmp(a, "--fullscreen"))
+			fullscreen = 1;
+		else if (!strcmp(a, "--help") || !strcmp(a, "-h")) {
+			printf("usage: umview [--title S] [--scale F] [--fullscreen]\n"
+			       "              [--probe] [--wait SEC] [--shot FILE]\n"
+			       "              [--frames N] [--px X,Y] <sink>\n");
+			return 0;
+		} else if (a[0] == '-' && a[1] == '-' && a[2] != '\0') {
+			die("unknown option %s (see --help)", a);
+		} else if (!sink) {
+			sink = a;
+		} else {
+			die("extra argument '%s'", a);
+		}
+	}
+	if (!sink)
+		die("no sink given (see --help)");
+
+	u.src = sink;
+	uv_open(&u, wait_ms);
+
+	if (probe) {
+		/* probe waits for a live frame, not just a header */
+		long t0 = now_ms();
+
+		while (__atomic_load_n(&u.hdr->seq, __ATOMIC_ACQUIRE) == 0) {
+			if (now_ms() - t0 >= wait_ms) {
+				rc = 9;
+				break;
+			}
+			usleep(20000);
+		}
+		printf("UMVIEW-PROBE %s magic=%08x version=%u mode=%ux%u "
+		       "stride=%u tiles=%ux%ux%u seq=%u full=%u state=%u hz=%u\n",
+		       rc ? "STALE" : "OK", u.hdr->magic, u.hdr->version,
+		       u.w, u.h, u.stride, u.tx, u.ty, u.total,
+		       u.hdr->seq, u.hdr->full, u.hdr->state, u.hdr->hz);
+		if (pxspec)
+			uv_probe_px(&u, pxspec);
+		return rc;
+	}
+
+	if (SDL_Init(SDL_INIT_VIDEO))
+		die("SDL_Init: %s", SDL_GetError());
+	signal(SIGINT, on_sigint);
+
+	{
+		char tbuf[128];
+		double sc = atof(scale);
+		int ww = (int) (u.w * sc + 0.5), wh = (int) (u.h * sc + 0.5);
+
+		if (!title) {
+			snprintf(tbuf, sizeof(tbuf), "umfb %ux%u", u.w, u.h);
+			title = tbuf;
+		}
+		u.win = SDL_CreateWindow(title, SDL_WINDOWPOS_CENTERED,
+					 SDL_WINDOWPOS_CENTERED, ww, wh,
+					 SDL_WINDOW_RESIZABLE |
+					 (fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0));
+		if (!u.win)
+			die("SDL_CreateWindow: %s", SDL_GetError());
+		u.ren = SDL_CreateRenderer(u.win, -1, SDL_RENDERER_ACCELERATED);
+		if (!u.ren)
+			u.ren = SDL_CreateRenderer(u.win, -1, SDL_RENDERER_SOFTWARE);
+		if (!u.ren)
+			die("SDL_CreateRenderer: %s", SDL_GetError());
+		u.tex = SDL_CreateTexture(u.ren, SDL_PIXELFORMAT_ABGR8888,
+					  SDL_TEXTUREACCESS_STREAMING,
+					  (int) u.w, (int) u.h);
+		if (!u.tex)
+			die("SDL_CreateTexture: %s", SDL_GetError());
+		/* logical size == the guest's screen: resizing letterboxes */
+		SDL_RenderSetLogicalSize(u.ren, (int) u.w, (int) u.h);
+
+		fprintf(stderr,
+			"umview: SDL video driver '%s', sink %ux%u stride %u, %ux%u %upx tiles\n",
+			SDL_GetCurrentVideoDriver(), u.w, u.h, u.stride,
+			u.tx, u.ty, 1u << u.ts);
+	}
+
+	u.shot = shot;
+	uv_paint_full(&u);
+	uv_present(&u);
+	u.shown = 1;
+	u.last_seq = __atomic_load_n(&u.hdr->seq, __ATOMIC_ACQUIRE);
+	u.have_last = 1;
+	if (u.shot) {
+		uv_shot(&u, u.shot);
+		u.shot = NULL;
+	}
+
+	while (!interrupted && !(u.frame_limit && u.shown >= u.frame_limit)) {
+		SDL_Event ev;
+
+		while (SDL_PollEvent(&ev)) {
+			if (ev.type == SDL_QUIT)
+				goto done;
+			if (ev.type == SDL_KEYDOWN) {
+				if (ev.key.keysym.sym == SDLK_ESCAPE)
+					goto done;
+				if (ev.key.keysym.sym == SDLK_F11) {
+					Uint32 fl = SDL_GetWindowFlags(u.win);
+
+					SDL_SetWindowFullscreen(u.win,
+						(fl & SDL_WINDOW_FULLSCREEN_DESKTOP) ?
+						0 : SDL_WINDOW_FULLSCREEN_DESKTOP);
+				}
+			}
+			if (ev.type == SDL_WINDOWEVENT &&
+			    (ev.window.event == SDL_WINDOWEVENT_EXPOSED ||
+			     ev.window.event == SDL_WINDOWEVENT_SIZE_CHANGED))
+				uv_present(&u);
+		}
+
+		{
+			uint32_t s1 = __atomic_load_n(&u.hdr->seq, __ATOMIC_ACQUIRE);
+
+			if (s1 != u.last_seq) {
+				uint32_t full = u.hdr->full;
+				uint32_t words[UMFB_MAX_WORDS];
+				uint32_t s2;
+
+				memcpy(words, (const void *) u.hdr->dirty_words,
+				       u.words * sizeof(uint32_t));
+				__atomic_thread_fence(__ATOMIC_ACQUIRE);
+				s2 = __atomic_load_n(&u.hdr->seq, __ATOMIC_ACQUIRE);
+				if (s2 == s1) {
+					if (full || !u.have_last)
+						uv_paint_full(&u);
+					else
+						uv_paint_tiles(&u, words);
+					uv_present(&u);
+					u.last_seq = s1;
+					u.have_last = 1;
+					u.shown++;
+					if (u.shot) {
+						uv_shot(&u, u.shot);
+						u.shot = NULL;
+					}
+					if (u.frame_limit && u.shown >= u.frame_limit)
+						goto done;
+				}
+			}
+		}
+		SDL_Delay(8);
+	}
+
+done:
+	SDL_Quit();
+	return 0;
+}
