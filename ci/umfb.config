# UML display: a framebuffer whose changed tiles are mirrored into a
# host file or fd, where viewers pick them up -- umview on Linux
# (tools/um-arm64/umview), the console app's display screen on Android.
# It activates with
#   umlfb=<path|fd:N>:<W>x<H>[-32][,hz=N][,tile=N]
# on the guest kernel command line and stays dormant without it.
#
# FB (the driver framework) sits behind HAS_IOMEM, which UML turns off
# by default: UML_IOMEM_EMULATION opens that gate.  This stack carries
# no fb-vfb route, so umfb is the only fbdev provider here.
CONFIG_UML_IOMEM_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_UML_FB=y

# Xorg needs a VT to bind to: its parse_vt_settings() opens /dev/tty0 and
# issues VT_OPENQRY, and with no VT driver that fd is the UML console device
# (major 4) whose ioctls answer ENOTTY -> "Cannot find a free VT: Inappropriate
# ioctl for device" and the server exits before it ever touches fb0 (measured
# on marble, Debian 13 guest, 2026-10-18).  VT stays console-less on purpose:
# printk belongs to the UML console (stack patch 0070 makes that coexistence
# legal in both directions), and VT_CONSOLE=y would only hand boot output to
# tty0 where nobody is watching.
CONFIG_EXPERT=y
CONFIG_VT=y
# CONFIG_VT_CONSOLE is not set
