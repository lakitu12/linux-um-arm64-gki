# UML display: a framebuffer whose changed tiles are mirrored into a
# host file or fd, where viewers pick them up -- umview on Linux
# (tools/um-arm64/umview), the console app's display screen on Android.
# It activates with
#   umlfb=<path|fd:N>:<W>x<H>[-32][,hz=N][,tile=N]
# on the guest kernel command line and stays dormant without it.
#
# FB (the driver framework) sits behind HAS_IOMEM, which UML turns off
# by default: UML_IOMEM_EMULATION opens that gate.  This stack carries
# no fb-vfb route, so umfb is the only fbdev provider here.
CONFIG_UML_IOMEM_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_UML_FB=y

# Xorg needs a VT to bind to (VT_OPENQRY on /dev/tty0), but CONFIG_VT takes
# major 4 away from the UML console: the kernel then has no console device at
# all ("Warning: unable to open an initial console"), /dev/console is gone for
# userland and the CI marker gate reads nothing (measured 2026-10-18, run
# 39141339058 -> boot gate red while the kernel itself booted fine).  So VT is
# NOT part of the default display fragment.  A guest that must run Xorg needs a
# variant built with CONFIG_EXPERT=y + CONFIG_VT=y on top of it, and a boot
# verdict that comes from the channel console instead of /dev/console.
