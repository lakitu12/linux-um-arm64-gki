# Android (redroid-class) guests: the gates config/docker.config does not cover.
#
# The GKI counterpart of the fragments the 7.2 tree carries for the same
# workload (redroid/netfilter in the app repository); every entry below was
# a measured boot gate there.  What is NOT repeated here is already in
# config/docker.config, which the default build merges:
#
#   bpfloader       -> BPF_SYSCALL / CGROUP_BPF
#   lmkd            -> MEMCG (PSI is added below)
#   vold user data  -> EXT4_FS_POSIX_ACL / EXT4_FS_SECURITY
#   netd            -> the full netfilter/nftables/xtables set
#   sdcard daemon   -> FUSE_FS (in ci/snap-flatpak.config)
#   overlayfs, seccomp, keys, POSIX mqueues ... likewise
#
# binder: what Android cannot boot without.  binderfs (Android 12+) gives a
# per-guest /dev/binder, which matters when two VMs share one host kernel.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
#
# ...and binder's own new prerequisite in this tree: ANDROID_BINDER_IPC
# carries "depends on EVENT_TRACING" here (the 7.2 tree does not), so the
# tracing core must exist before the symbol is even visible.  FTRACE opens
# the Tracers menu, and one tracer selects GENERIC_TRACER -> TRACING ->
# EVENT_TRACING; SCHED_TRACER is the lightest of them.  Both lines are
# load-bearing — measured: drop the tracer and binder drops with it; drop
# FTRACE and the tracer has nowhere to live.  Guests get a working tracing
# subsystem out of it as a side effect.
CONFIG_FTRACE=y
CONFIG_SCHED_TRACER=y
#
# lmkd again: boot-critical, exits at startup without a pressure source and
# init's onrestart chain takes zygote down with it.  PSI is the modern source
# (/proc/pressure/memory); the memcg v1 fallback comes from docker.config.
CONFIG_PSI=y
#
# netd's last kernel faces beyond the docker set: the xt owner/socket matches
# its chains use, and socket lookup for both address families.  (The MARK
# target+match rides in docker.config as NETFILTER_XT_MARK — the combined
# module that NETFILTER_XT_TARGET_MARK only selects.)
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y